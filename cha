from selenium import webdriver
from selenium.webdriver.chrome.service import Service
from webdriver_manager.chrome import ChromeDriverManager
from selenium.webdriver.common.by import By
import time
import os

# Setup WebDriver
service = Service(ChromeDriverManager().install())
driver = webdriver.Chrome(service=service)

# Load local HTML file
file_path = 'file://' + os.path.abspath('index.html')
driver.get(file_path)

# Define test cases: (num1, num2, expected_sum)
test_cases = [
    ('3', '4', '7.0'),
    ('10', '15', '25.0'),
    ('-5', '2', '-3.0'),
    ('0', '0', '0.0'),
    ('2.5', '3.1', '5.6')
]

for num1, num2, expected in test_cases:
    # Refresh the page to reset inputs
    driver.get(file_path)
    time.sleep(0.5)

    # Fill in numbers
    driver.find_element(By.ID, 'num1').clear()
    driver.find_element(By.ID, 'num2').clear()
    driver.find_element(By.ID, 'num1').send_keys(num1)
    driver.find_element(By.ID, 'num2').send_keys(num2)

    # Click the Add button
    driver.find_element(By.ID, 'addBtn').click()

    # Wait briefly for result to update
    time.sleep(0.5)

    # Get and verify result
    result = driver.find_element(By.ID, 'result').text.strip()
    assert result == expected, f"❌ {num1} + {num2} = {result}, expected {expected}"
    print(f"✅ Test passed: {num1} + {num2} = {expected}")

# Close browser
driver.quit()


